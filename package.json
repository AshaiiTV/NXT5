{
  "name": "nxt5-netlify",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "netlify dev",
    "build": "vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "optimize:assets": "node tools/optimize-assets.mjs",
    "local-importer": "node tools/nxt5-importer.mjs",
    "local-import-export": "node tools/nxt5-importer.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test && npm run build",
    "db:migrate": "node tools/migrate.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "@netlify/functions": "^2.8.2",
    "argon2": "^0.44.0",
    "bcryptjs": "^3.0.3",
    "openai": "^7.8.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "^25.9.3",
    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "^10.4.20",
    "esbuild": "0.28.2",
    "lucide-react": "^0.468.0",
    "pg": "8.23.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-test-renderer": "18.3.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.17",
    "typescript": "^6.0.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  }
}
