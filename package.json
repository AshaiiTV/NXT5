{
  "name": "nxt5-netlify",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "netlify dev",
    "prototype:drafter": "node tools/drafter-prototype.mjs",
    "build": "vite build && node tools/prerender.mjs",
    "build:preview": "node tools/build-preview.mjs",
    "test": "vitest run",
    "test:layout": "node tools/verify-roster-layout.mjs",
    "preview": "vite preview",
    "optimize:assets": "node tools/optimize-assets.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "i18n:check": "node tools/check-i18n.mjs",
    "verify": "npm run i18n:check && npm run typecheck && npm test && npm run build",
    "db:migrate": "node tools/migrate.mjs",
    "discord:commands": "node tools/register-discord-commands.mjs",
    "discord:check-bundle": "node tools/verify-discord-bundle.mjs",
    "bench:history": "vitest run --config tools/bench-history/config.mjs --configLoader native"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@napi-rs/canvas": "1.0.13",
    "@neondatabase/serverless": "^1.2.0",
    "@netlify/blobs": "11.1.7",
    "@netlify/functions": "^6.0.3",
    "argon2": "^0.45.1",
    "bcryptjs": "^3.0.3",
    "gsap": "3.15.0",
    "jose": "6.2.13",
    "openai": "^7.45.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.13",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^26.6.6",
    "@typescript/typescript6": "6.0.2",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "lucide-react": "^1.63.0",
    "pg": "8.23.1",
    "playwright": "1.62.1",
    "postcss": "^8.5.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-test-renderer": "19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "source-map-js": "1.2.2"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "allowScripts": {
    "argon2@0.45.1": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
