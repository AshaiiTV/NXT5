  "subtitles": [
    {
      "id": "1a",
      "from": 398,
      "to": 544,
      "text": "Sur nxt5.org, dans « Préparation et partage », ouvre « Bot Discord »."
    },
    {
      "id": "1b",
      "from": 544,
      "to": 670,
      "text": "Dans l’onglet « Serveur », clique sur « Ajouter à Discord »."
    },
    {
      "id": "1c",
      "from": 670,
      "to": 800,
      "text": "Discord s’ouvre : choisis ton serveur, puis « Continuer »."
    },
    {
      "id": "1d",
      "from": 800,
      "to": 1000,
      "text": "Le bot demande l’autorisation « Administrateur » : tous les droits, y compris dans les salons privés."
    },
    {
      "id": "1e",
      "from": 1000,
      "to": 1120,
      "text": "Clique sur « Autoriser » : le bot rejoint ton serveur."
    },
    {
      "id": "2a",
      "from": 1158,
      "to": 1330,
      "text": "Dans un salon de ton serveur, tape /nxt lier et envoie la commande."
    },
    {
      "id": "2b",
      "from": 1330,
      "to": 1448,
      "text": "Le bot te répond en privé : clique sur « Ouvrir NXT5 »."
    },
    {
      "id": "2c",
      "from": 1448,
      "to": 1614,
      "text": "Vérifie les deux comptes et clique sur « Confirmer mon compte NXT5 »."
    },
    {
      "id": "2d",
      "from": 1614,
      "to": 1794,
      "text": "De retour dans Discord : « Vérifier la liaison », puis « Confirmer la liaison »."
    },
    {
      "id": "2e",
      "from": 1794,
      "to": 1970,
      "text": "Sur NXT5, clique sur « J’ai confirmé dans Discord · Vérifier » : ton compte est lié."
    },
    {
      "id": "3a",
      "from": 2008,
      "to": 2210,
      "text": "Clique sur « Créer le code de liaison », puis « Copier la commande »."
    },
    {
      "id": "3b",
      "from": 2210,
      "to": 2370,
      "text": "Colle la commande dans ton serveur Discord et envoie-la."
    },
    {
      "id": "3c",
      "from": 2370,
      "to": 2490,
      "text": "Sur NXT5, le serveur apparaît : « Serveur relié »."
    },
    {
      "id": "4a",
      "from": 2528,
      "to": 2726,
      "text": "Onglet « Salons » : choisis le salon des commandes, puis « Associer ce salon »."
    },
    {
      "id": "4b",
      "from": 2726,
      "to": 2936,
      "text": "Choisis le salon des résultats, « Ajouter ce salon », puis « Enregistrer les salons »."
    },
    {
      "id": "4c",
      "from": 2936,
      "to": 3032,
      "text": "Puis « Passer au test et à l’activation »."
    },
    {
      "id": "5a",
      "from": 3070,
      "to": 3236,
      "text": "Onglet « Activation » : clique sur « Envoyer le message de test »."
    },
    {
      "id": "5b",
      "from": 3236,
      "to": 3376,
      "text": "Le message de test arrive dans le salon, visible par ses membres."
    },
    {
      "id": "5c",
      "from": 3376,
      "to": 3530,
      "text": "Sur NXT5, « Test reçu sur Discord » : clique sur « Activer la diffusion »."
    },
    {
      "id": "5d",
      "from": 3530,
      "to": 3676,
      "text": "Relis le récapitulatif, puis clique sur « Confirmer l’activation »."
    },
    {
      "id": "5e",
      "from": 3676,
      "to": 3796,
      "text": "« Diffusion active » : ton équipe peut utiliser le bot."
    },
    {
      "id": "6a",
      "from": 3834,
      "to": 3956,
      "text": "Ouvre une partie et clique sur « Exporter sur Discord »."
    },
    {
      "id": "6b",
      "from": 3956,
      "to": 4056,
      "text": "Clique sur « Préparer l’aperçu »."
    },
    {
      "id": "6c",
      "from": 4056,
      "to": 4226,
      "text": "Vérifie l’aperçu, puis clique sur « Publier dans #résultats »."
    },
    {
      "id": "6d",
      "from": 4226,
      "to": 4390,
      "text": "Ta partie est dans le salon."
    },
    {
      "id": "7a",
      "from": 4390,
      "to": 4498,
      "text": "C’est fait : ta partie est publiée sur Discord."
    },
    {
      "id": "7b",
      "from": 4498,
      "to": 4644,
      "text": "Les nouvelles parties importées sont ensuite publiées automatiquement."
    }
  ],
