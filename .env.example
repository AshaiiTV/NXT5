DATABASE_URL=postgresql://user:password@host/db?sslmode=require
RIOT_API_KEY=RGAPI-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Riot Sign On : accès approuvé séparément, secrets Netlify Functions uniquement.
# Voir docs/social-provider-configuration.md. Ne jamais activer par défaut ni sur les Deploy Previews.
RIOT_RSO_ENABLED=false
RIOT_RSO_APPROVAL_CONFIRMED=false
RIOT_RSO_CLIENT_ID=
# Exactement client_secret_basic ou private_key_jwt, selon le client approuvé.
RIOT_RSO_CLIENT_AUTH_METHOD=
RIOT_RSO_SITE_ORIGIN=https://nxt5.org
# Conserver exactement l’URL déjà soumise/approuvée par Riot. L’ancien chemin
# ci-dessous et /.netlify/functions/auth-social-callback sont pris en charge.
RIOT_RSO_REDIRECT_URI=https://nxt5.org/.netlify/functions/auth-riot-callback
RIOT_RSO_POST_LOGOUT_REDIRECT_URI=https://nxt5.org/connexion
RIOT_RSO_ACCOUNT_REGION=europe
# Client Basic uniquement :
RIOT_RSO_CLIENT_SECRET=
# Client private_key_jwt uniquement : clé PEM RSA >=2048 bits et kid enregistrés.
RIOT_RSO_PRIVATE_KEY=
RIOT_RSO_PRIVATE_KEY_ID=
# Audience confirmée du client : https://auth.riotgames.com/token ou https://auth.riotgames.com.
RIOT_RSO_PRIVATE_KEY_AUDIENCE=
# Minimum 64 caractères. Génère avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-with-a-long-random-string-minimum-64-chars
APP_ENV=production
PUBLIC_SITE_URL=https://ton-site.netlify.app
# URL HTTPS publique de la page de soutien (Ko-fi, par exemple).
# Laisser vide tant que les contributions ne sont pas ouvertes.
# Choix du montant et de la fréquence sur la plateforme ; aucun secret ici.
VITE_NXT5_SUPPORT_URL=
# Administrateur plateforme unique. Préfère l'UUID immuable ; si les deux sont
# renseignés, l'utilisateur authentifié doit correspondre aux deux valeurs.
PLATFORM_ADMIN_USER_ID=00000000-0000-0000-0000-000000000000
# L'accès par email exige que l'adresse du compte soit vérifiée.
PLATFORM_ADMIN_EMAIL=admin@ton-domaine.fr
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESET_EMAIL_FROM=NXT5 <noreply@ton-domaine.fr>

# Discord : secrets côté Functions uniquement, contexte production uniquement.
# La fonctionnalité reste désactivée tant que ce drapeau n'est pas true.
DISCORD_PUBLISHING_ENABLED=false
DISCORD_ENVIRONMENT=production
DISCORD_APPLICATION_ID=
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
# Secret aléatoire >=32 caractères, distinct de SESSION_SECRET.
DISCORD_WORKER_SECRET=
# Réservé aux tests locaux avec un bot et une base dédiés :
DISCORD_LOCAL_PILOT=false

# Connexions Google, Discord et Apple : secrets côté Functions uniquement.
# Activation manuelle après configuration des consoles et validation du parcours.
# Voir docs/social-provider-configuration.md. Aucun secret avec le préfixe VITE_.
SOCIAL_AUTH_SITE_ORIGIN=https://nxt5.org
GOOGLE_AUTH_ENABLED=false
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
DISCORD_AUTH_ENABLED=false
# OAuth utilisateur : indépendant du bot de publication Discord ci-dessus.
DISCORD_AUTH_CLIENT_ID=
DISCORD_AUTH_CLIENT_SECRET=
APPLE_AUTH_ENABLED=false
# Services ID web associé au Primary App ID prévu pour l’application Apple.
APPLE_AUTH_CLIENT_ID=
APPLE_AUTH_TEAM_ID=
APPLE_AUTH_KEY_ID=
# Contenu PEM de la clé Sign in with Apple .p8 (P-256), sauts de ligne ou \n.
APPLE_AUTH_PRIVATE_KEY=
