{
  "name": "nxt5-importer",
  "version": "0.3.3",
  "private": true,
  "author": "NXT5",
  "description": "NXT5 local League of Legends match importer",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.mjs",
    "dist:win": "electron-builder --win portable --x64",
    "dist:mac": "node scripts/build-mac.mjs x64",
    "dist:mac:arm": "node scripts/build-mac.mjs arm64",
    "dist:mac:preview": "node scripts/build-mac.mjs --preview"
  },
  "devDependencies": {
    "electron": "44.2.0",
    "electron-builder": "26.15.3"
  },
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "build": {
    "appId": "app.nxt5.importer",
    "productName": "NXT5 Importer",
    "copyright": "Copyright © 2026 NXT5",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "src/main.js"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "NXT5-Importer-Windows-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NXT5 Importer"
    },
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.sports",
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "NXT5-Importer-Mac-${arch}-${version}.${ext}",
      "type": "distribution",
      "forceCodeSigning": true,
      "hardenedRuntime": true,
      "notarize": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    }
  }
}
